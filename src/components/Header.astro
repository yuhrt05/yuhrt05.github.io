---
import Link from '@/components/Link.astro'
import ThemeToggle from '@/components/ThemeToggle.astro'
import { NAV_LINKS, SITE } from '@/consts'
---

<div>
  <div
    class="mx-auto flex max-w-4xl items-center justify-between gap-4 px-4 py-3.5"
  >
    {/* Left: Minimalist Brand with Favicon */}
    <Link
      href="/"
      class="group flex items-center gap-2.5 font-mono text-sm tracking-tight transition-opacity hover:opacity-80"
    >
      <img
        src="/favicon.svg"
        alt="ANe"
        class="size-6 rounded-md object-cover"
      />
      <span class="font-bold tracking-tight text-base text-foreground">ANe</span>
    </Link>

    {/* Right: Clean Monospace Nav & Theme Toggle */}
    <div class="flex items-center gap-3">
      <nav class="flex items-center gap-1 font-mono text-xs sm:gap-2">
        {
          NAV_LINKS.map((item) => (
            <Link
              href={item.href}
              class="rounded-md px-2.5 py-1 text-muted-foreground transition-colors hover:bg-muted hover:text-foreground capitalize"
            >
              {item.label}
            </Link>
          ))
        }
      </nav>
      <div class="h-3.5 w-px bg-border"></div>
      <ThemeToggle transition:persist />
    </div>
  </div>
</div>
