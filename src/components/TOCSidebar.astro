---
import { ScrollArea } from '@/components/ui/scroll-area'
import type { TOCSection, TOCHeading } from '@/lib/data-utils'
import { getParentId, isSubpost } from '@/lib/data-utils'
import { cn } from '@/lib/utils'
import { Icon } from 'astro-icon/components'

type Props = {
  sections: TOCSection[]
  currentPostId: string
}

const { sections, currentPostId } = Astro.props
const isCurrentSubpost = isSubpost(currentPostId)
const parentId = isCurrentSubpost ? getParentId(currentPostId) : currentPostId

function getHeadingClasses(depth: number) {
  switch (depth) {
    case 2:
      return 'text-[13px] font-semibold text-foreground/85 hover:text-foreground py-0.5'
    case 3:
      return 'text-xs font-medium text-muted-foreground hover:text-foreground pl-3 border-l border-border/40 hover:border-foreground/40 py-0.5'
    case 4:
      return 'text-[11.5px] text-muted-foreground/75 hover:text-foreground pl-5 border-l border-border/25 hover:border-foreground/30 py-0.5 leading-relaxed line-clamp-2'
    default:
      return 'text-[11px] text-muted-foreground/60 hover:text-foreground pl-7 border-l border-border/15 hover:border-foreground/20 py-0.5 leading-relaxed line-clamp-2'
  }
}

type HeadingGroup = {
  root: TOCHeading
  children: TOCHeading[]
  allSlugs: string[]
}

function groupHeadings(headings: TOCHeading[]): HeadingGroup[] {
  if (!headings || headings.length === 0) return []

  const hasDepth2 = headings.some((h) => h.depth === 2)
  const rootDepth = hasDepth2 ? 2 : Math.min(...headings.map((h) => h.depth))

  const groups: HeadingGroup[] = []
  let currentGroup: HeadingGroup | null = null

  for (const h of headings) {
    if (h.depth <= rootDepth || currentGroup === null) {
      currentGroup = {
        root: h,
        children: [],
        allSlugs: [h.slug],
      }
      groups.push(currentGroup)
    } else {
      currentGroup.children.push(h)
      currentGroup.allSlugs.push(h.slug)
    }
  }

  // Filter out any standalone depth 1 title repeat that has no children
  return groups.filter(
    (g) => !(g.root.depth === 1 && g.children.length === 0),
  )
}
---

{
  sections.length > 0 && (
    <aside
      id="toc-sidebar-container"
      class="sticky top-20 col-start-3 row-span-1 mr-auto ml-8 xl:ml-10 hidden h-[calc(100vh-6rem)] w-72 xl:block select-none"
    >
      {/* Refined Minimalist Header */}
      <div class="flex items-center gap-1.5 pb-2 mb-2 border-b border-border/40 font-mono text-[11px] font-medium uppercase tracking-wider text-muted-foreground/75">
        <Icon name="lucide:align-left" class="size-3 text-muted-foreground/60" />
        <span>Contents</span>
      </div>

      <ScrollArea
        client:load
        className="flex max-h-[calc(100vh-10rem)] flex-col overflow-y-auto pr-1"
        type="hover"
        data-toc-scroll-area
      >
        <div class="flex flex-col gap-1.5 font-sans">
          {sections.map((section, index) => {
            const isFirstSubpost =
              section.type === 'subpost' &&
              (index === 0 || sections[index - 1].type === 'parent')

            const groups = groupHeadings(section.headings)

            return (
              <>
                {isFirstSubpost && (
                  <div class="my-2 flex items-center gap-2 font-mono text-[10px] text-muted-foreground uppercase tracking-wider">
                    <div class="bg-border h-px flex-1" />
                    <span>Subposts</span>
                    <div class="bg-border h-px flex-1" />
                  </div>
                )}

                {section.type === 'parent' ? (
                  <div class="flex flex-col gap-1">
                    {groups.map((group) => {
                      const hasChildren = group.children.length > 0

                      return (
                        <div
                          class="toc-group flex flex-col"
                          data-group-id={group.root.slug}
                          data-group-slugs={JSON.stringify(group.allSlugs)}
                        >
                          {/* Mục lớn / Root heading */}
                          <div class="flex items-center justify-between group/root py-0.5">
                            <a
                              href={
                                isCurrentSubpost
                                  ? `/blog/${parentId}#${group.root.slug}`
                                  : `#${group.root.slug}`
                              }
                              class={cn(
                                'flex-1 transition-colors duration-150',
                                getHeadingClasses(group.root.depth),
                                isCurrentSubpost && 'text-foreground/40',
                              )}
                              data-heading-link={group.root.slug}
                              title={group.root.text}
                            >
                              {group.root.text}
                            </a>

                            {hasChildren && (
                              <button
                                type="button"
                                class="toc-toggle-btn ml-1 flex size-5 shrink-0 items-center justify-center rounded text-muted-foreground/40 transition-colors hover:text-foreground"
                                data-toggle-target={group.root.slug}
                                aria-label={`Toggle ${group.root.text}`}
                              >
                                <svg
                                  class="toc-chevron size-3 transition-transform duration-250 ease-out"
                                  viewBox="0 0 24 24"
                                  fill="none"
                                  stroke="currentColor"
                                  stroke-width="2"
                                  stroke-linecap="round"
                                  stroke-linejoin="round"
                                >
                                  <polyline points="6 9 12 15 18 9" />
                                </svg>
                              </button>
                            )}
                          </div>

                          {/* Children dropdown accordion */}
                          {hasChildren && (
                            <div
                              class="toc-collapse-content grid transition-[grid-template-rows,opacity] duration-280 ease-in-out"
                              data-collapse-id={group.root.slug}
                              data-expanded="false"
                            >
                              <div class="overflow-hidden min-h-0">
                                <ul class="flex list-none flex-col gap-y-0.5 pt-0.5 pb-1">
                                  {group.children.map((child) => (
                                    <li
                                      class={cn(
                                        'transition-colors duration-150',
                                        getHeadingClasses(child.depth),
                                        isCurrentSubpost && 'text-foreground/40',
                                      )}
                                    >
                                      <a
                                        href={
                                          isCurrentSubpost
                                            ? `/blog/${parentId}#${child.slug}`
                                            : `#${child.slug}`
                                        }
                                        class="block transition-colors duration-150"
                                        data-heading-link={child.slug}
                                        title={child.text}
                                      >
                                        {child.text}
                                      </a>
                                    </li>
                                  ))}
                                </ul>
                              </div>
                            </div>
                          )}
                        </div>
                      )
                    })}
                  </div>
                ) : (
                  <div
                    class={cn(
                      'rounded-md border p-2 my-1 transition-colors',
                      section.subpostId === currentPostId
                        ? 'bg-muted/40 border-border/60'
                        : 'border-border/30 hover:bg-muted/20',
                    )}
                  >
                    <ul class="flex list-none flex-col gap-y-0.5 font-sans">
                      <li
                        class={cn(
                          'text-xs font-semibold',
                          section.subpostId === currentPostId
                            ? 'text-foreground'
                            : 'text-foreground/60',
                        )}
                      >
                        <a
                          href={
                            section.subpostId === currentPostId
                              ? '#'
                              : `/blog/${section.subpostId}`
                          }
                          class="block transition-colors duration-150 hover:text-foreground"
                          data-heading-link={
                            section.subpostId === currentPostId
                              ? 'top'
                              : `${section.subpostId}-top`
                          }
                        >
                          {section.title}
                        </a>
                      </li>
                      {section.headings.map((heading) => (
                        <li
                          class={cn(
                            'transition-colors duration-150',
                            getHeadingClasses(heading.depth),
                            section.subpostId === currentPostId
                              ? 'text-foreground/70'
                              : 'text-foreground/30',
                          )}
                        >
                          <a
                            href={
                              section.subpostId === currentPostId
                                ? `#${heading.slug}`
                                : `/blog/${section.subpostId}#${heading.slug}`
                            }
                            class="block transition-colors duration-150"
                            data-heading-link={
                              section.subpostId === currentPostId
                                ? heading.slug
                                : `${section.subpostId}-${heading.slug}`
                            }
                            title={heading.text}
                          >
                            {heading.text}
                          </a>
                        </li>
                      ))}
                    </ul>
                  </div>
                )}
              </>
            )
          })}
        </div>
      </ScrollArea>
    </aside>
  )
}

<style>
  .toc-collapse-content {
    grid-template-rows: 0fr;
    opacity: 0;
    pointer-events: none;
  }
  .toc-collapse-content[data-expanded="true"] {
    grid-template-rows: 1fr;
    opacity: 1;
    pointer-events: auto;
  }
  .toc-chevron {
    transform: rotate(-90deg);
  }
  .toc-chevron[data-expanded="true"] {
    transform: rotate(0deg);
  }
</style>

<script>
  const HEADER_OFFSET = 95

  class TOCState {
    links: NodeListOf<Element> = document.querySelectorAll(
      '#toc-sidebar-container [data-heading-link]',
    )
    activeId: string | null = null
    headings: HTMLElement[] = []
    scrollArea: HTMLElement | null = null
    tocScrollArea: HTMLElement | null = null

    reset() {
      this.links = document.querySelectorAll(
        '#toc-sidebar-container [data-heading-link]',
      )
      this.activeId = null
      this.headings = []
      const tocContainer = document.getElementById('toc-sidebar-container')
      this.scrollArea =
        tocContainer?.querySelector('[data-radix-scroll-area-viewport]') || null
      this.tocScrollArea =
        tocContainer?.querySelector('[data-toc-scroll-area]') || null
    }
  }

  const state = new TOCState()

  class HeadingRegions {
    static build() {
      state.headings = Array.from(
        document.querySelectorAll<HTMLElement>(
          '.prose h2, .prose h3, .prose h4, .prose h5, .prose h6',
        ),
      )
    }

    static getActiveId(): string | null {
      if (state.headings.length === 0) return null

      // Reading line right below header
      const readingLine = window.scrollY + HEADER_OFFSET

      // Do not activate prematurely if scroll hasn't reached the first heading
      if (state.headings[0].offsetTop > readingLine) {
        return null
      }

      let activeId: string | null = null

      for (let i = 0; i < state.headings.length; i++) {
        const heading = state.headings[i]
        if (heading.offsetTop <= readingLine) {
          activeId = heading.id
        } else {
          break
        }
      }

      return activeId
    }
  }

  class TOCAccordion {
    static groups: {
      id: string
      slugs: string[]
      contentEl: HTMLElement | null
      chevronEl: HTMLElement | null
    }[] = []

    static activeGroupId: string | null = null

    static build() {
      const groupEls = document.querySelectorAll<HTMLElement>(
        '#toc-sidebar-container [data-group-id]',
      )
      this.groups = Array.from(groupEls).map((el) => {
        const id = el.getAttribute('data-group-id') || ''
        let slugs: string[] = []
        try {
          slugs = JSON.parse(el.getAttribute('data-group-slugs') || '[]')
        } catch {
          slugs = [id]
        }
        return {
          id,
          slugs,
          contentEl: el.querySelector<HTMLElement>(`[data-collapse-id="${id}"]`),
          chevronEl: el.querySelector<HTMLElement>('.toc-chevron'),
        }
      })
      this.activeGroupId = null
    }

    static expandGroup(targetId: string | null) {
      if (this.activeGroupId === targetId) return
      this.activeGroupId = targetId

      this.groups.forEach((group) => {
        const isTarget = group.id === targetId
        if (group.contentEl) {
          group.contentEl.setAttribute('data-expanded', isTarget ? 'true' : 'false')
        }
        if (group.chevronEl) {
          group.chevronEl.setAttribute('data-expanded', isTarget ? 'true' : 'false')
        }
      })
    }

    static findGroupIdForSlug(slug: string | null): string | null {
      if (!slug) return null
      for (const group of this.groups) {
        if (group.slugs.includes(slug)) {
          return group.id
        }
      }
      return null
    }
  }

  class TOCScrollMask {
    static update() {
      if (!state.scrollArea || !state.tocScrollArea) return

      const { scrollTop, scrollHeight, clientHeight } = state.scrollArea
      const threshold = 5
      const isAtTop = scrollTop <= threshold
      const isAtBottom = scrollTop >= scrollHeight - clientHeight - threshold

      state.tocScrollArea.classList.toggle('mask-t-from-90%', !isAtTop)
      state.tocScrollArea.classList.toggle('mask-b-from-90%', !isAtBottom)
    }
  }

  class TOCLinks {
    static update(activeId: string | null) {
      state.links.forEach((link) => {
        link.classList.remove('!text-foreground', '!font-semibold', 'text-foreground')
        link.parentElement?.classList.remove('!border-foreground', 'border-foreground')
      })

      if (activeId) {
        const activeLink = document.querySelector(
          `#toc-sidebar-container [data-heading-link="${activeId}"]`,
        )
        if (activeLink) {
          activeLink.classList.add('!text-foreground', '!font-semibold')
          activeLink.parentElement?.classList.add('!border-foreground')
        }
        this.scrollToActive(activeId)
      }
    }

    static scrollToActive(activeId: string) {
      if (!state.scrollArea || !activeId) return

      const activeLink = document.querySelector(
        `#toc-sidebar-container [data-heading-link="${activeId}"]`,
      )
      if (!activeLink) return

      const { top: areaTop, height: areaHeight } =
        state.scrollArea.getBoundingClientRect()
      const { top: linkTop, height: linkHeight } =
        activeLink.getBoundingClientRect()

      const currentLinkTop = linkTop - areaTop + state.scrollArea.scrollTop
      const targetScroll = Math.max(
        0,
        Math.min(
          currentLinkTop - (areaHeight - linkHeight) / 2,
          state.scrollArea.scrollHeight - state.scrollArea.clientHeight,
        ),
      )

      if (Math.abs(targetScroll - state.scrollArea.scrollTop) > 5) {
        state.scrollArea.scrollTop = targetScroll
      }
    }
  }

  class TOCController {
    static isClicking = false

    static handleScroll() {
      if (this.isClicking) return
      const activeId = HeadingRegions.getActiveId()

      if (activeId !== state.activeId) {
        state.activeId = activeId
        const targetGroupId = TOCAccordion.findGroupIdForSlug(activeId)
        TOCAccordion.expandGroup(targetGroupId)
        TOCLinks.update(state.activeId)
      }
      TOCScrollMask.update()
    }

    static handleTOCScroll = () => TOCScrollMask.update()

    static handleResize() {
      HeadingRegions.build()
      TOCAccordion.build()
      const activeId = HeadingRegions.getActiveId()

      if (activeId !== state.activeId) {
        state.activeId = activeId
        const targetGroupId = TOCAccordion.findGroupIdForSlug(activeId)
        TOCAccordion.expandGroup(targetGroupId)
        TOCLinks.update(state.activeId)
      }

      TOCScrollMask.update()
    }

    static init() {
      state.reset()
      HeadingRegions.build()
      TOCAccordion.build()

      if (state.headings.length === 0) {
        TOCLinks.update(null)
        TOCAccordion.expandGroup(null)
        return
      }

      // Bind click on links to lock highlight directly to clicked item and expand group
      state.links.forEach((link) => {
        link.addEventListener('click', () => {
          const id = link.getAttribute('data-heading-link')
          if (id) {
            this.isClicking = true
            state.activeId = id
            const targetGroupId = TOCAccordion.findGroupIdForSlug(id)
            TOCAccordion.expandGroup(targetGroupId)
            TOCLinks.update(id)
            setTimeout(() => {
              this.isClicking = false
            }, 800)
          }
        })
      })

      // Bind manual toggle chevron buttons
      const toggleBtns = document.querySelectorAll<HTMLElement>(
        '#toc-sidebar-container [data-toggle-target]',
      )
      toggleBtns.forEach((btn) => {
        btn.addEventListener('click', (e) => {
          e.preventDefault()
          e.stopPropagation()
          const targetId = btn.getAttribute('data-toggle-target')
          if (!targetId) return
          if (TOCAccordion.activeGroupId === targetId) {
            TOCAccordion.expandGroup(null)
          } else {
            TOCAccordion.expandGroup(targetId)
          }
        })
      })

      this.handleScroll()
      setTimeout(TOCScrollMask.update, 100)

      const options = { passive: true }
      window.addEventListener('scroll', this.handleScroll, options)
      window.addEventListener('resize', this.handleResize, options)
      state.scrollArea?.addEventListener(
        'scroll',
        this.handleTOCScroll,
        options,
      )
    }

    static cleanup() {
      window.removeEventListener('scroll', this.handleScroll)
      window.removeEventListener('resize', this.handleResize)
      state.scrollArea?.removeEventListener('scroll', this.handleTOCScroll)

      Object.assign(state, {
        activeId: null,
        headings: [],
        scrollArea: null,
        tocScrollArea: null,
      })
      TOCAccordion.groups = []
      TOCAccordion.activeGroupId = null
    }
  }

  document.addEventListener('astro:page-load', () => TOCController.init())
  document.addEventListener('astro:after-swap', () => {
    TOCController.cleanup()
    TOCController.init()
  })
  document.addEventListener('astro:before-swap', () => TOCController.cleanup())
</script>
