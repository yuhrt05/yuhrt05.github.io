---
import AvatarComponent from '@/components/ui/avatar'
import { Badge } from '@/components/ui/badge'
import { Separator } from '@/components/ui/separator'
import {
  getCombinedReadingTime,
  getSubpostCount,
  isCTFPost,
  isSubpost,
  parseAuthors,
} from '@/lib/data-utils'
import { formatDate } from '@/lib/utils'
import { Icon } from 'astro-icon/components'
import { Image } from 'astro:assets'
import type { CollectionEntry } from 'astro:content'
import Link from './Link.astro'

interface Props {
  entry: CollectionEntry<'blog'>
}

const { entry } = Astro.props
const formattedDate = formatDate(entry.data.date)
const readTime = await getCombinedReadingTime(entry.id)
const authors = await parseAuthors(entry.data.authors ?? [])
const subpostCount = !isSubpost(entry.id) ? await getSubpostCount(entry.id) : 0
const isCTF = isCTFPost(entry)
---

<div
  class="group relative overflow-hidden rounded-lg border border-border bg-card/40 p-4 sm:p-5 transition-colors duration-200 hover:border-foreground/40 hover:bg-muted/20"
>
  <Link
    href={`/${entry.collection}/${entry.id}`}
    class="flex flex-col gap-4 sm:flex-row sm:items-start"
  >
    {
      entry.data.image && (
        <div class="relative aspect-[16/10] w-full sm:w-52 sm:h-32 shrink-0 self-start overflow-hidden rounded-md border border-border bg-muted/30">
          <Image
            src={entry.data.image}
            alt={entry.data.title}
            width={600}
            height={375}
            quality={95}
            class="h-full w-full object-cover grayscale-[20%] group-hover:grayscale-0 transition-all duration-300"
          />
        </div>
      )
    }

    <div class="flex grow flex-col justify-between self-stretch min-w-0">
      <div>
        {/* Meta Header */}
        <div class="mb-2 flex flex-wrap items-center justify-between gap-2 font-mono text-[11px] text-muted-foreground">
          <div class="flex items-center gap-2 font-medium">
            {
              isCTF ? (
                <span class="inline-flex items-center gap-1 rounded bg-red-500/10 text-red-400 border border-red-500/20 px-1.5 py-0.5 text-[10px] uppercase font-semibold">
                  <Icon name="lucide:flag" class="size-2.5" />
                  CTF
                </span>
              ) : (
                <span class="inline-flex items-center gap-1 rounded bg-blue-500/10 text-blue-400 border border-blue-500/20 px-1.5 py-0.5 text-[10px] uppercase font-semibold">
                  <Icon name="lucide:flask-conical" class="size-2.5" />
                  LAB
                </span>
              )
            }
            <div class="flex items-center gap-1 text-muted-foreground">
              <Icon name="lucide:calendar" class="size-3 text-muted-foreground" />
              <span>{formattedDate}</span>
            </div>
          </div>

          <div class="flex items-center gap-2">
            <span class="flex items-center gap-1">
              <Icon name="lucide:clock" class="size-3" />
              {readTime}
            </span>

            {
              subpostCount > 0 && (
                <>
                  <span>•</span>
                  <span class="flex items-center gap-1">
                    <Icon name="lucide:file-text" class="size-3" />
                    {subpostCount} subpost{subpostCount === 1 ? '' : 's'}
                  </span>
                </>
              )
            }

            {
              entry.data.password && (
                <>
                  <span>•</span>
                  <span class="flex items-center gap-1 text-foreground" title="Protected">
                    <Icon name="lucide:lock" class="size-3" />
                    Encrypted
                  </span>
                </>
              )
            }
          </div>
        </div>

        {/* Title */}
        <h3 class="mb-1.5 text-base sm:text-lg font-semibold tracking-tight text-foreground group-hover:underline">
          {entry.data.title}
        </h3>

        {/* Description */}
        <p class="mb-3 text-sm text-muted-foreground line-clamp-2 leading-relaxed">
          {entry.data.description}
        </p>
      </div>

      {/* Meta Footer: Author & Tags */}
      <div class="flex flex-wrap items-center justify-between gap-2 pt-2 border-t border-border/50">
        <div class="flex items-center gap-2">
          {
            authors.length > 0 && authors.map((author) => (
              <div class="flex items-center gap-1.5 font-mono text-[11px] text-muted-foreground">
                <AvatarComponent
                  client:load
                  src={author.avatar}
                  alt={author.name}
                  fallback={author.name[0]}
                  className="size-4 rounded-full border border-border"
                />
                <span>@{author.name}</span>
              </div>
            ))
          }
        </div>

        {
          entry.data.tags && entry.data.tags.length > 0 && (
            <div class="flex flex-wrap items-center gap-1.5">
              {entry.data.tags.map((tag) => (
                <span class="inline-flex items-center gap-1 rounded bg-muted/60 px-2 py-0.5 font-mono text-[10px] text-muted-foreground border border-border/60 transition-colors group-hover:text-foreground">
                  <Icon name="lucide:hash" class="size-2.5 opacity-60" />
                  {tag}
                </span>
              ))}
            </div>
          )
        }
      </div>
    </div>
  </Link>
</div>
