---
import BlogCard from '@/components/BlogCard.astro'
import Breadcrumbs from '@/components/Breadcrumbs.astro'
import PageHead from '@/components/PageHead.astro'
import Layout from '@/layouts/Layout.astro'
import {
  getAllPosts,
  groupPostsByYear,
  isCTFPost,
  isLabPost,
} from '@/lib/data-utils'
import { Icon } from 'astro-icon/components'

const allPosts = await getAllPosts()
const ctfPosts = allPosts.filter(isCTFPost)
const labPosts = allPosts.filter(isLabPost)

const ctfByYear = groupPostsByYear(ctfPosts)
const ctfYears = Object.keys(ctfByYear).sort((a, b) => parseInt(b) - parseInt(a))

const labsByYear = groupPostsByYear(labPosts)
const labsYears = Object.keys(labsByYear).sort((a, b) => parseInt(b) - parseInt(a))
---

<Layout class="max-w-4xl">
  <PageHead slot="head" title="Articles & Write-ups" />
  <Breadcrumbs
    items={[
      { label: 'Blog', href: '/blog', icon: 'lucide:library-big' },
      { label: 'All', icon: 'lucide:book-copy' },
    ]}
  />

  <div class="flex min-h-[calc(100vh-18rem)] flex-col gap-y-8">
    {/* Page Header */}
    <div class="flex flex-col gap-y-2 font-mono">
      <div class="flex items-center gap-2">
        <h1 class="text-xl sm:text-2xl font-bold tracking-tight text-foreground uppercase">
          Articles & Write-ups
        </h1>
      </div>
      <p class="text-xs text-muted-foreground">
        {allPosts.length} posts categorized into Labs & Research and CTFs.
      </p>

      {/* Category Filter Tabs */}
      <div class="mt-3 flex flex-wrap items-center gap-2" id="category-tabs" role="tablist">
        <button
          type="button"
          data-tab="all"
          class="tab-btn inline-flex items-center gap-1.5 rounded-md px-3 py-1.5 text-xs font-medium transition-all cursor-pointer bg-foreground text-background shadow-sm"
        >
          <Icon name="lucide:layout-grid" class="size-3.5" />
          <span>All</span>
          <span class="rounded bg-background/20 px-1 py-0.2 text-[10px] font-mono">
            {allPosts.length}
          </span>
        </button>

        <button
          type="button"
          data-tab="labs"
          class="tab-btn inline-flex items-center gap-1.5 rounded-md px-3 py-1.5 text-xs font-medium transition-all cursor-pointer bg-muted/60 text-muted-foreground hover:text-foreground hover:bg-muted border border-border/40"
        >
          <Icon name="lucide:flask-conical" class="size-3.5" />
          <span>Labs and Research</span>
          <span class="rounded bg-muted px-1.5 py-0.5 text-[10px] font-mono text-foreground font-semibold">
            {labPosts.length}
          </span>
        </button>

        <button
          type="button"
          data-tab="ctf"
          class="tab-btn inline-flex items-center gap-1.5 rounded-md px-3 py-1.5 text-xs font-medium transition-all cursor-pointer bg-muted/60 text-muted-foreground hover:text-foreground hover:bg-muted border border-border/40"
        >
          <Icon name="lucide:flag" class="size-3.5" />
          <span>CTFs</span>
          <span class="rounded bg-muted px-1.5 py-0.5 text-[10px] font-mono text-foreground font-semibold">
            {ctfPosts.length}
          </span>
        </button>
      </div>
    </div>

    {/* Section 1: Labs and Research */}
    <section id="section-labs" class="category-section flex flex-col gap-y-6">
      <div class="flex items-center justify-between gap-3 border-b border-border pb-2.5 font-mono">
        <div class="flex items-center gap-2">
          <Icon name="lucide:flask-conical" class="size-4 text-muted-foreground" />
          <h2 class="text-base sm:text-lg font-bold tracking-tight text-foreground uppercase">
            Labs and Research
          </h2>
        </div>
        <span class="text-xs text-muted-foreground">
          {labPosts.length} posts
        </span>
      </div>

      {
        labsYears.map((year) => (
          <div class="flex flex-col gap-y-3">
            <div class="flex items-center font-mono">
              <span class="inline-flex items-center gap-2 rounded bg-muted/50 px-2 py-0.5 text-xs text-muted-foreground border border-border/50">
                <span class="font-semibold text-foreground">{year}</span>
                <span class="h-2.5 w-px bg-border"></span>
                <span class="text-[11px]">{labsByYear[year].length} posts</span>
              </span>
            </div>
            <ul class="flex flex-col gap-3.5">
              {labsByYear[year].map((post) => (
                <li>
                  <BlogCard entry={post} />
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </section>

    {/* Section 2: CTFs */}
    <section id="section-ctf" class="category-section flex flex-col gap-y-6 pt-2">
      <div class="flex items-center justify-between gap-3 border-b border-border pb-2.5 font-mono">
        <div class="flex items-center gap-2">
          <Icon name="lucide:flag" class="size-4 text-muted-foreground" />
          <h2 class="text-base sm:text-lg font-bold tracking-tight text-foreground uppercase">
            CTFs
          </h2>
        </div>
        <span class="text-xs text-muted-foreground">
          {ctfPosts.length} posts
        </span>
      </div>

      {
        ctfYears.map((year) => (
          <div class="flex flex-col gap-y-3">
            <div class="flex items-center font-mono">
              <span class="inline-flex items-center gap-2 rounded bg-muted/50 px-2 py-0.5 text-xs text-muted-foreground border border-border/50">
                <span class="font-semibold text-foreground">{year}</span>
                <span class="h-2.5 w-px bg-border"></span>
                <span class="text-[11px]">{ctfByYear[year].length} posts</span>
              </span>
            </div>
            <ul class="flex flex-col gap-3.5">
              {ctfByYear[year].map((post) => (
                <li>
                  <BlogCard entry={post} />
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </section>
  </div>
</Layout>

<script is:inline>
  function setupCategoryTabs() {
    const tabs = document.querySelectorAll('.tab-btn');
    const sectionCtf = document.getElementById('section-ctf');
    const sectionLabs = document.getElementById('section-labs');

    if (!tabs.length || !sectionCtf || !sectionLabs) return;

    function applyTab(selectedTab) {
      tabs.forEach((btn) => {
        const isCurrent = btn.getAttribute('data-tab') === selectedTab;
        if (isCurrent) {
          btn.className = 'tab-btn inline-flex items-center gap-1.5 rounded-md px-3 py-1.5 text-xs font-medium transition-all cursor-pointer bg-foreground text-background shadow-sm';
        } else {
          btn.className = 'tab-btn inline-flex items-center gap-1.5 rounded-md px-3 py-1.5 text-xs font-medium transition-all cursor-pointer bg-muted/60 text-muted-foreground hover:text-foreground hover:bg-muted border border-border/40';
        }
      });

      if (selectedTab === 'ctf') {
        sectionCtf.style.display = 'flex';
        sectionLabs.style.display = 'none';
      } else if (selectedTab === 'labs') {
        sectionCtf.style.display = 'none';
        sectionLabs.style.display = 'flex';
      } else {
        sectionCtf.style.display = 'flex';
        sectionLabs.style.display = 'flex';
      }
    }

    // Check URL hash
    const initialHash = window.location.hash.replace('#', '');
    if (['all', 'ctf', 'labs'].includes(initialHash)) {
      applyTab(initialHash);
    } else {
      applyTab('all');
    }

    tabs.forEach((btn) => {
      btn.addEventListener('click', () => {
        const tab = btn.getAttribute('data-tab');
        applyTab(tab);
        window.history.replaceState(null, '', tab === 'all' ? window.location.pathname : `#${tab}`);
      });
    });
  }

  // Run on initial load and View Transitions
  setupCategoryTabs();
  document.addEventListener('astro:after-swap', setupCategoryTabs);
  document.addEventListener('astro:page-load', setupCategoryTabs);
</script>
