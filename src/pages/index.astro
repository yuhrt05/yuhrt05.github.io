---
import Link from '@/components/Link.astro'
import PageHead from '@/components/PageHead.astro'
import Layout from '@/layouts/Layout.astro'
import {
  getAllPosts,
  getPostReadingTime,
  isCTFPost,
  isLabPost,
} from '@/lib/data-utils'
import { Icon } from 'astro-icon/components'

const allPosts = await getAllPosts()
const postCount = allPosts.length
const labPosts = allPosts.filter(isLabPost)
const ctfPosts = allPosts.filter(isCTFPost)
const recentPosts = allPosts.slice(0, 8)

const recentPostsData = await Promise.all(
  recentPosts.map(async (post) => ({
    post,
    readingTime: await getPostReadingTime(post.id),
    isLab: isLabPost(post),
  })),
)
---

<Layout class="max-w-4xl">
  <PageHead slot="head" title="Home" />

  <div class="space-y-10 pt-2 sm:pt-4">
    {/* Minimalist Header */}
    <section class="space-y-3">
      <div class="space-y-1.5">
        <h1 class="font-mono text-3xl sm:text-4xl font-bold tracking-tight text-foreground">
          yuhrt05
        </h1>
        <p class="font-mono text-xs sm:text-sm text-muted-foreground">
          Digital Forensics &bull; Incident Response &bull; Threat Hunting
        </p>
      </div>

      <div>
        <Link
          href="/authors"
          class="font-mono text-xs sm:text-sm text-muted-foreground hover:text-foreground inline-flex items-center gap-1.5 transition-colors"
        >
          <Icon name="lucide:user" class="size-4" />
          <span>About the author</span>
          <Icon name="lucide:arrow-right" class="size-3.5" />
        </Link>
      </div>
    </section>

    {/* Refined Minimalist Category Navigation */}
    <section class="border-y border-border/40 py-3">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-y-3 sm:gap-0 font-mono text-xs sm:text-sm">
        <Link
          href="/blog#labs"
          class="group flex items-center justify-between text-muted-foreground hover:text-foreground transition-colors py-1 sm:pr-6"
        >
          <div class="flex items-center gap-2.5">
            <Icon
              name="lucide:flask-conical"
              class="size-4 text-muted-foreground/80 group-hover:text-foreground transition-colors"
            />
            <span class="group-hover:underline font-medium">Labs &amp; Investigations</span>
          </div>
          <div class="flex items-center gap-1.5 text-xs text-muted-foreground/70 group-hover:text-foreground">
            <span>{labPosts.length} posts</span>
            <Icon
              name="lucide:arrow-right"
              class="size-3 transition-transform group-hover:translate-x-0.5"
            />
          </div>
        </Link>

        <Link
          href="/blog#ctf"
          class="group flex items-center justify-between text-muted-foreground hover:text-foreground transition-colors py-1 sm:border-l sm:border-border/30 sm:pl-6"
        >
          <div class="flex items-center gap-2.5">
            <Icon
              name="lucide:flag"
              class="size-4 text-muted-foreground/80 group-hover:text-foreground transition-colors"
            />
            <span class="group-hover:underline font-medium">CTF Forensics</span>
          </div>
          <div class="flex items-center gap-1.5 text-xs text-muted-foreground/70 group-hover:text-foreground">
            <span>{ctfPosts.length} posts</span>
            <Icon
              name="lucide:arrow-right"
              class="size-3 transition-transform group-hover:translate-x-0.5"
            />
          </div>
        </Link>
      </div>
    </section>

    {/* Clean, Light Post List */}
    <section class="space-y-3 pt-2">
      <div class="flex items-center justify-between font-mono pb-1">
        <span class="text-xs sm:text-sm font-semibold text-muted-foreground uppercase tracking-wider">
          Recent Write-ups
        </span>
        <Link
          href="/blog"
          class="text-xs sm:text-sm text-muted-foreground hover:text-foreground transition-colors"
        >
          View all ({postCount}) &rarr;
        </Link>
      </div>

      <ul class="divide-y divide-border/40 border-t border-b border-border/40 font-mono text-xs sm:text-sm">
        {recentPostsData.map(({ post, readingTime, isLab }) => (
          <li>
            <Link
              href={`/blog/${post.id}`}
              class="group flex items-center justify-between gap-4 py-3.5 sm:py-4 transition-colors hover:text-foreground"
            >
              <div class="flex items-center gap-3.5 min-w-0">
                <span class="text-xs text-muted-foreground shrink-0 w-16 sm:w-20">
                  {post.data.date.toLocaleDateString('en-US', {
                    month: 'short',
                    day: 'numeric',
                  })}
                </span>
                <span class="text-xs text-muted-foreground/70 shrink-0">
                  [{isLab ? 'LAB' : 'CTF'}]
                </span>
                <span class="text-foreground/90 group-hover:text-foreground group-hover:underline truncate text-sm sm:text-base">
                  {post.data.title}
                </span>
              </div>

              <span class="text-xs text-muted-foreground shrink-0 hidden sm:inline">
                {readingTime}
              </span>
            </Link>
          </li>
        ))}
      </ul>
    </section>
  </div>
</Layout>
