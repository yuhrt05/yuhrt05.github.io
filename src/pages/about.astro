---
import BlogCard from '@/components/BlogCard.astro'
import Breadcrumbs from '@/components/Breadcrumbs.astro'
import Link from '@/components/Link.astro'
import PageHead from '@/components/PageHead.astro'
import Layout from '@/layouts/Layout.astro'
import { getRecentPosts } from '@/lib/data-utils'

const recentPosts = await getRecentPosts(3)
---

<Layout class="max-w-3xl">
  <PageHead slot="head" title="About" />
  <Breadcrumbs items={[{ label: 'About', icon: 'lucide:info' }]} />

  <section>
    <div class="min-w-full">
      <div class="prose mb-8">
        <p class="mt-0">
          ANe's blog focuses on <strong>security</strong> with a strong emphasis
          on <strong>Blue Team</strong>: SOC fundamentals, threat hunting,
          detection engineering, introductory malware analysis, incident
          response, and practical system hardening. The goal is to keep
          everything hands-on, with checklists, labs, and real-world log
          examples you can apply immediately.
        </p>
        <p>
          If you’re getting started, explore the Blog and these core resources:
          <Link href="https://attack.mitre.org" external underline
            >MITRE ATT&CK</Link
          >,
          <Link href="https://www.splunk.com" external underline>Splunk</Link>,
          <Link href="https://sigmahq.io" external underline>Sigma</Link>, and <Link
            href="https://docs.velociraptor.app"
            external
            underline>Velociraptor</Link
          >.
        </p>
      </div>

      <h2 class="mb-4 text-xl font-bold font-mono uppercase tracking-tight text-foreground">
        Recent Write-ups & Labs
      </h2>
      <div class="flex flex-col gap-3.5">
        {recentPosts.map((post) => <BlogCard entry={post} />)}
      </div>
    </div>
  </section>
</Layout>
