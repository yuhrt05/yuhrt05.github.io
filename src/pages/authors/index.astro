---
import Breadcrumbs from '@/components/Breadcrumbs.astro'
import Link from '@/components/Link.astro'
import PageHead from '@/components/PageHead.astro'
import Layout from '@/layouts/Layout.astro'
import { getAllPosts } from '@/lib/data-utils'
import { Icon } from 'astro-icon/components'

const allPosts = await getAllPosts()
const postCount = allPosts.length
---

<Layout class="max-w-4xl">
  <PageHead slot="head" title="About" />
  <Breadcrumbs items={[{ label: 'About', icon: 'lucide:user' }]} />

  <div class="pt-2 sm:pt-4">
    {/* Author Dossier Card */}
    <section class="rounded-2xl border border-border/70 bg-card/40 p-6 sm:p-8 space-y-6 shadow-sm">
      {/* Profile Header */}
      <div class="flex flex-col sm:flex-row items-start sm:items-center gap-5 sm:gap-6">
        <div class="size-20 sm:size-24 shrink-0 overflow-hidden rounded-2xl border border-border bg-muted/20 p-1">
          <img
            src="/assets/avatar.jpg"
            alt="ANe"
            class="h-full w-full rounded-xl object-cover grayscale-[10%]"
          />
        </div>

        <div class="space-y-1.5 flex-1">
          <div class="flex flex-wrap items-center gap-2.5">
            <h1 class="font-mono text-2xl sm:text-3xl font-bold tracking-tight text-foreground">
              ANe
            </h1>
            <span class="font-mono text-xs text-muted-foreground">
              (yuhrt05)
            </span>
            <div class="flex items-center gap-1.5 ml-0.5">
              <Link
                href="https://github.com/yuhrt05"
                aria-label="GitHub (yuhrt05)"
                title="GitHub (yuhrt05)"
                class="flex size-6 items-center justify-center rounded-md border border-border/50 bg-muted/20 text-muted-foreground hover:text-foreground hover:bg-muted/50 hover:border-border transition-all"
                external
              >
                <Icon name="lucide:github" class="size-3.5" />
              </Link>

              <Link
                href="https://cyberdefenders.org/p/ANe/"
                aria-label="CyberDefenders (ANe)"
                title="CyberDefenders (ANe)"
                class="flex size-6 items-center justify-center rounded-md border border-border/50 bg-muted/20 text-muted-foreground hover:text-foreground hover:bg-muted/50 hover:border-border transition-all"
                external
              >
                <Icon name="simple-icons:cyberdefenders" class="size-3.5" />
              </Link>
            </div>
          </div>

          <p class="font-mono text-xs sm:text-sm text-muted-foreground italic">
            &ldquo;A little each day adds up to a lot.&rdquo;
          </p>
        </div>
      </div>

      {/* 3 Metric Cards - Bé bé xinh xinh, phông sau nhám nhám (Frosted Glass) */}
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 sm:gap-3.5 font-mono">
        <div class="rounded-xl border border-border/70 dark:border-white/[0.08] bg-muted/30 dark:bg-muted/15 backdrop-blur-md p-3.5 sm:p-4 space-y-2 hover:border-foreground/30 transition-all shadow-sm">
          <div class="flex items-center gap-1.5 text-[11px] text-muted-foreground uppercase tracking-wider font-semibold">
            <Icon name="lucide:graduation-cap" class="size-3.5 text-muted-foreground" />
            <span>EDUCATION</span>
          </div>
          <div class="space-y-0.5">
            <div class="text-sm sm:text-[15px] font-bold text-foreground tracking-tight">
              4th-Year Student
            </div>
            <p class="text-[11px] sm:text-xs text-muted-foreground leading-relaxed">
              Academy of Cryptography Techniques (KMA)
            </p>
          </div>
        </div>

        <div class="rounded-xl border border-border/70 dark:border-white/[0.08] bg-muted/30 dark:bg-muted/15 backdrop-blur-md p-3.5 sm:p-4 space-y-2 hover:border-foreground/30 transition-all shadow-sm">
          <div class="flex items-center gap-1.5 text-[11px] text-muted-foreground uppercase tracking-wider font-semibold">
            <Icon name="lucide:briefcase" class="size-3.5 text-muted-foreground" />
            <span>CURRENT ROLE</span>
          </div>
          <div class="space-y-0.5">
            <div class="text-sm sm:text-[15px] font-bold text-foreground tracking-tight">
              DFIR Intern
            </div>
            <p class="text-[11px] sm:text-xs text-muted-foreground leading-relaxed">
              Vietnam National Cyber Security Technology (NCS)
            </p>
          </div>
        </div>

        <div class="rounded-xl border border-border/70 dark:border-white/[0.08] bg-muted/30 dark:bg-muted/15 backdrop-blur-md p-3.5 sm:p-4 space-y-2 hover:border-foreground/30 transition-all shadow-sm">
          <div class="flex items-center gap-1.5 text-[11px] text-muted-foreground uppercase tracking-wider font-semibold">
            <Icon name="lucide:file-text" class="size-3.5 text-muted-foreground" />
            <span>RESEARCH &amp; LABS</span>
          </div>
          <div class="space-y-0.5">
            <div class="text-sm sm:text-[15px] font-bold text-foreground tracking-tight">
              {postCount} Documented Cases
            </div>
            <p class="text-[11px] sm:text-xs text-muted-foreground leading-relaxed">
              DFIR &bull; CTF &bull; SIEM Labs
            </p>
          </div>
        </div>
      </div>

      {/* Refined Unified Navigation Bar */}
      <div class="pt-1">
        <nav
          aria-label="Author navigation"
          class="inline-flex flex-wrap items-center gap-1 rounded-xl border border-border/70 dark:border-white/[0.08] bg-muted/30 dark:bg-muted/15 backdrop-blur-md p-1.5 font-mono text-xs shadow-sm"
        >
          <Link
            href="/blog"
            class="group inline-flex items-center gap-2 rounded-lg px-3 py-1.5 font-medium text-foreground hover:bg-muted/60 dark:hover:bg-white/[0.08] transition-all"
          >
            <Icon
              name="lucide:file-text"
              class="size-3.5 text-muted-foreground group-hover:text-foreground transition-colors"
            />
            <span>Write-ups</span>
            <span
              class="rounded-md bg-muted/80 dark:bg-white/[0.08] border border-border/60 px-1.5 py-0.5 text-[10.5px] font-semibold text-muted-foreground group-hover:text-foreground transition-colors"
            >
              {postCount}
            </span>
          </Link>

          <div class="h-3.5 w-px bg-border/60 mx-1 hidden sm:block" />

          <Link
            href="/tags"
            class="group inline-flex items-center gap-1.5 rounded-lg px-3 py-1.5 text-muted-foreground hover:text-foreground hover:bg-muted/60 dark:hover:bg-white/[0.08] transition-all"
          >
            <Icon name="lucide:hash" class="size-3.5 transition-colors" />
            <span>Tags</span>
          </Link>

          <div class="h-3.5 w-px bg-border/60 mx-1 hidden sm:block" />

          <Link
            href="/archives"
            class="group inline-flex items-center gap-1.5 rounded-lg px-3 py-1.5 text-muted-foreground hover:text-foreground hover:bg-muted/60 dark:hover:bg-white/[0.08] transition-all"
          >
            <Icon name="lucide:calendar" class="size-3.5 transition-colors" />
            <span>Archives</span>
          </Link>
        </nav>
      </div>
    </section>
  </div>
</Layout>
